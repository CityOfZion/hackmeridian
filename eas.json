{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      }
    },
    "release": {
      "distribution": "internal",
      "environment": "production",
      "node": "24.11.1",
      "pnpm": "10.32.1",
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      }
    }
  }
}
