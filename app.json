{
  "expo": {
    "name": "VaultPass",
    "slug": "hackmeridian",
    "scheme": "vaultpass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.raulduartep.hackmeridian"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.NFC",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.raulduartep.hackmeridian"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to confirm sign-ins and card funding with Face ID."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to confirm sign-ins and card funding with Face ID."
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Giving $(PRODUCT_NAME) access to NFC will allow you to read your Vault Pass",
          "includeNdefEntitlement": false,
          "selectIdentifiers": ["FF6974656D73797303000000", "D2760000850101"]
        }
      ],
      "react-native-quick-crypto",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "pt-PT"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3cb4735f-019a-49a1-afe1-f5c183571f3d"
      }
    },
    "owner": "raulduartep"
  }
}
