# Copy to .env.local (git-ignored). EXPO_PUBLIC_ values are bundled into the app in plain text.

# sandbox (default) or production. Production moves real money: use it only in local builds you never distribute.
EXPO_PUBLIC_BUNQ_ENV=sandbox

# Sandbox: leave empty to let the app create its own bunq sandbox user on first launch.
# Production: required (a production API key from the bunq app).
EXPO_PUBLIC_BUNQ_API_KEY=
