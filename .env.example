# Copy to .env.local (git-ignored). EXPO_PUBLIC_ values are bundled into the app in plain text.
# The P-256 smart-account dashboard only needs the backend URL below.
EXPO_PUBLIC_VAULTPASS_API_URL=

# Legacy G-account funding settings below are retained for future migration; the current dashboard does not use them.

# bunq production API key (required, from the bunq app). Cards and limits are real money, and the key is readable
# by anyone who has the build.
EXPO_PUBLIC_BUNQ_API_KEY=

# Stellar network for funds: mainnet (default, real money) or testnet.
EXPO_PUBLIC_STELLAR_NETWORK=mainnet
# Funding delivers EURC to this G… address from the Pass's account (its Ed25519 key), paid with EURC or with USDC
# converted on Stellar's exchange in the same transaction. It must exist on the network above with an EURC trustline.
EXPO_PUBLIC_STELLAR_RECEIVER=
# Optional: asset issuers; default to Circle's USDC and EURC on the selected network.
EXPO_PUBLIC_STELLAR_USDC_ISSUER=
EXPO_PUBLIC_STELLAR_EURC_ISSUER=
