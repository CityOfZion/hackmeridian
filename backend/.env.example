# Mainnet service configuration. Keep actual values in backend/.env (git-ignored).
CHALLENGE_SECRET=
CHANNELS_API_KEY=
P256_VERIFIER_ADDRESS=CA5ZJMYHPBW6ZSA5OYAJD3L54MHAN5PUKY5FVT7DXZIZ42YGTSDNRSQF
ALLOW_ACCOUNT_CREATION=false
STELLAR_RPC_URL=https://mainnet.sorobanrpc.com
HOST=127.0.0.1
PORT=8787
# Enable only behind a local proxy that overwrites X-Real-IP. Never expose port 8787 publicly.
TRUST_LOOPBACK_PROXY=false

# Direct XLM/USDC/EURC transfers; Channels sponsors the envelope.
ALLOW_TRANSFERS=false
MAX_TRANSFER_RESOURCE_FEE=10000000
# Optional absolute path on a persistent volume; default backend/data/transfers.sqlite
TRANSFER_DB_PATH=

# Independent backup card enrollment (full spending and account administration authority).
ALLOW_BACKUPS=false
# Persist and back up alongside TRANSFER_DB_PATH. Required for new-phone card/account discovery.
BACKUP_DB_PATH=

# Enable only after deploying the pinned, reviewed freeze policy. Existing accounts
# require one card-authorized policy installation per signing rule before freezing.
ALLOW_FREEZE=false
# Defaults beside TRANSFER_DB_PATH; preserve this journal during migration/recovery.
# FREEZE_DB_PATH=/var/lib/vaultpass/freeze.sqlite
